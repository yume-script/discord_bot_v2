# 주의: 값 뒤에 같은 줄로 주석을 붙이지 마세요 (특히 값이 빈 줄 - 주석이 값으로 읽힙니다). 주석은 윗줄에.
# 기본값은 코드의 기본값과 같게 둔다 - scripts/sync_env.py가 .env에 없는 변수를 이 값으로 채운다 (배포 때 자동).
# Discord
DISCORD_BOT_TOKEN=
# 애순이 디스코드 계정(말하기 전용). 카톡 연동 채널의 애순이 답장과 포링푸드 일지/장면을 이 계정으로 올린다.
# 비우면 전부 아메하나 계정으로. 초대 권한: View Channel / Send Messages / Send Messages in Threads / Read Message History
AESUN_BOT_TOKEN=
# 소라 디스코드 계정 - 맡은 일 없이 로그인만 (상태 메시지는 선택). 비우면 로그인 안 함.
SORA_BOT_TOKEN=
SORA_BOT_ACTIVITY=
# 보조 계정 키 목록 (포링푸드 에이전트를 최대 5명까지 늘릴 때 키 추가 + {KEY}_BOT_TOKEN, poring_food/data/agents.json에 인물 추가)
SIDE_BOT_KEYS=aesun,sora,kaje
# 카제 봇 - 봇 토큰 없는 에이전트들이 말하는 채널 웹훅을 찾거나 만든다 (채널 '웹후크 관리' 권한 필요)
KAJE_BOT_TOKEN=
# 웹훅을 직접 만들었으면 URL을 넣는다 (넣으면 카제/아메하나의 웹후크 권한이 필요 없다)
PORING_AGENT_WEBHOOK_URL=
# 관리자 디스코드 사용자 ID (쉼표 구분) - /포링푸드실행 등 관리자 명령어 허용
ADMIN_DISCORD_IDS=
# 봇이 실제로 들어가 있는 서버 ID (개발자 모드 켜고 서버 아이콘 우클릭 -> ID 복사)
DISCORD_GUILD_ID=
# comma-separated channel IDs, 대괄호/따옴표 없이. 예: 591180628842774554,591180628842774555
DISCORD_LOG_CHANNEL_IDS=

# Kakao (디스코드 채널 릴레이 방식 - 원본 봇과 동일)
# 카톡 애순이가 해요체로 대할 사람 (말투 전용, 권한과 무관). 나머지는 합쇼체. 유저ID(member_no) 권장.
KAKAO_FAMILIAR_USER_IDS=
KAKAO_FAMILIAR_NAMES=유메미루
# 답장을 내보낼 때만 사용 (예: http://192.168.0.50:3000)
KATALK_BRIDGE_URL=
# 카톡이 릴레이되는 디스코드 채널 ID들 (comma-separated, 기존 TARGET_THREAD_IDS)
KATALK_LINKED_CHANNEL_IDS=
NICKNAME_DELIMITER=//

# 자율 응답(호출어 없이 확률적으로 참견) - 카톡/디스코드 공용, 기존 봇과 동일 기본값
AUTO_REPLY_TRIGGER_KEYWORDS=아메하나,애순이,똑똑,안녕
AUTO_REPLY_COOLDOWN_SEC=60
AUTO_REPLY_PROBABILITY=0.03
# 호출어로 부른 뒤 이 시간(초) 동안은 같은 사람이 호출어 없이 말해도 답한다 (0이면 끔)
CALL_FOLLOWUP_SEC=300

# 대화 맥락 - 애순이가 답할 때 참고하는 최근 메시지 개수 (SQLite에서 조회)
CONVERSATION_CONTEXT_LIMIT=12

# LLM (LiteLLM proxy)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Image generation backend (AI Horde)
IMAGE_GEN_BACKEND=horde
IMAGE_GEN_MAX_CONCURRENCY=2
HORDE_API_KEY=
HORDE_DEFAULT_MODEL=Nova Anime XL


# 부팅 때 MCP 서버별 연결 대기 시간(초). SSH로 붙는 bookoasis가 자주 타임아웃되면 늘린다.
MCP_CONNECT_TIMEOUT_SEC=30
# MCP 서버 시크릿 - config/mcp_servers.yaml이 "${변수명}"으로 참조한다 (yaml엔 값을 적지 않음)
TAUTULLI_API_KEY=
PLEX_TOKEN=
PUBLIC_DATA_API_SECRET=

# 봇이 반응하지 않을 자동화 발신자 이름 (쉼표로 여러 개). ".GAS"로 끝나는 이름과
# 카톡 릴레이가 아닌 웹훅은 등록하지 않아도 자동으로 무시된다.
GAS_WEBHOOK_NAMES=4KHD_SNDER.GAS

# scripts/new_content_notifier.py (크론) - 새 콘텐츠 알림을 보낼 채널
NEW_CONTENT_NOTIFY_CHANNEL_ID=

# Redroid 패키지 감시 결과를 봇이 알릴 채널 (비우면 끔) - cogs/redroid_watch.py
REDROID_NOTIFY_CHANNEL_ID=591180628842774554
REDROID_EVENTS_PATH=/mnt/redroid_watch/events.jsonl

# 포링푸드 (poring_food/ - 매시 애순이 일지, cogs/poring_food.py)
PORING_FOOD_ENABLED=1
PORING_FOOD_RUN_MINUTE=3
# 봇이 직접 올릴 채널 (비우면 아래 웹훅 사용)
PORING_DISCORD_CHANNEL_ID=
# 예전 포링푸드 .env의 DISCORD_WEBHOOK_URL
PORING_DISCORD_WEBHOOK_URL=
# 예전 포링푸드 .env의 ROOM_ID
PORING_KAKAO_ROOM_ID=
# 비우면 LITELLM_MODEL (예전 .env의 LLM_MODEL)
PORING_LLM_MODEL=
# 예전 .env의 SEARCH_MODEL
PORING_SEARCH_MODEL=gemini-search
# 중요한 판단(모임 결론/프로젝트 계획/연대기/세계 엔진 계획/작가 회의/주간 실적 발표)에만 쓰는 상위 모델 (비우면 끔)
# 무료 키는 하루 요청이 적어서 하루 이만큼만 쓰고, 넘거나 실패하면 기본 모델로 다시 부른다
PORING_LLM_MODEL_SMART=gemini-free3_7
PORING_LLM_SMART_DAILY_MAX=15
# 인물 전용 모델 "모델:이름,이름;모델2:이름" - 그 인물의 판단/대화/모임 발언/투표는 그 모델로 (실패하면 기본 모델로)
# 애순이는 실제 카톡 대화가 프롬프트에 들어가니 외부 모델에 넣지 않는 걸 권함. 비우면 끔
PORING_AGENT_MODELS=groq_free:소라,김동식,조이서,오상식,이지안,오동백,권민우,최수연,정명석,리정혁
# 인물 전용 모델이 추론 모델이면 생각 토큰을 줄인다 (low/medium/high, 비우면 안 보냄)
PORING_AGENT_MODEL_REASONING=low
# 인물 전용 모델의 분당 토큰 예산 (키 수 x 키당 분당 한도, 예: groq 키 5개 x 8,000 = 40000 / 키 10개면 80000, 0이면 끔)
# 한도에 가까우면 최대 WAIT_SEC초 기다렸다가, 그래도 안 되면 그 호출만 기본 모델로 (429가 안 나게)
PORING_AGENT_MODEL_TPM=40000
PORING_AGENT_MODEL_WAIT_SEC=15
# 매시 판단을 동시에 몇 명씩 - 기본 모델(무료 Gemini 분당 15회라 1) / 인물 전용 모델(groq 묶음)
PORING_AGENT_DECIDE_PARALLEL=1
PORING_AGENT_DECIDE_PARALLEL_OWN=2
# 회차 시작/끝 알림 - 카톡방에만 보낸다 (디스코드엔 안 감, 0이면 끔)
PORING_TICK_NOTICE=1
# 이상 감지 - LiteLLM 다운/키 한도·거부/판단 실패/대화 없음/회차 지연이 이어지면 카톡방에 원인을 짚어 알림 (0이면 끔)
PORING_HEALTH_ALERT=1
# 인생 전환점 - 하루 몇 명에게 삶의 큰 변화(승진 심사/연애/이사/목표 달성...), 목표 갱신 (0이면 끔)
# 하루 인원 (0이면 에이전트 수에 맞춰 한 사람당 한 달 1.5번꼴)
PORING_MILESTONES=1
PORING_MILESTONES_PER_DAY=0
# 봇 오락실 - 인물들이 개인시간에 봇 미니게임(블랙잭/주사위/바카라...)을 직접 한다 (이야기 속 돈, 0이면 끔)
# 방 이름(사람 머니와 따로) / 한 판 최대 금액 / 한 사람 하루 판 수
PORING_ARCADE=1
PORING_ARCADE_ROOM=poring_food_world
PORING_ARCADE_MAX_BET=100000
PORING_ARCADE_MAX_PER_DAY=3
# 오락기 주인(실적 자리 "오락기 매출"의 처음 담당) / 오락기가 있는 곳
PORING_ARCADE_MANAGER=오윤
PORING_ARCADE_PLACE=LP바 오락기
# 빌런 - agents.json "villain"이 있는 인물(장대희/권민우/부상길)의 악역 연기 원칙 + 며칠에 한 번 수작 (0이면 끔)
PORING_VILLAINS=1
PORING_VILLAIN_EVERY_DAYS=2
# 바깥 세상 뉴스 - Google 트렌드(한국 검색어) + Google 뉴스(분야별 헤드라인/업계) RSS, 키 없음, 하루 3번 (0이면 끔)
# 더 거를 단어 (쉼표로, 기본으로 정치/선거/사건사고/전쟁/혐오는 거른다)
PORING_NEWS=1
PORING_NEWS_BLOCK=
# 인물들이 봇 명령어를 쓴다 - /주식 /환율(실제 시세 가상 투자) /운세 /그림 /개미소리 (0이면 끔)
# 한 번 매수 최대 금액(이야기 속 돈) / 그림 그리는 인물 / 하루 그림 수 / 하루 개미소리 짤 수
PORING_HOBBIES=1
PORING_STOCK_MAX_BUY=2000000
PORING_ARTISTS=박충섭,오윤
PORING_DRAW_PER_DAY=2
PORING_ANT_PER_DAY=3
# 시간 안의 파급 라운드 - 대화/소문/단톡방을 겪은 사람이 반응할지 말지 스스로 따져 보고, 반응하면 새 대화/글로 이어진다
# 연쇄 깊이(0이면 끔) / 한 시간 반응 고민 상한(전체) / 한 사람 한 시간 반응 상한 / 반응으로 생기는 대화 상한
PORING_RIPPLE_ROUNDS=3
PORING_RIPPLE_MAX_REACTIONS=20
PORING_RIPPLE_PER_PERSON=5
PORING_RIPPLE_CONVOS_PER_HOUR=5
# 대화/단톡방/연재 장면을 이야기 속 시각대로 한 마디씩 차례대로 올린다 (0이면 만드는 즉시 몰아서 - 예전 방식)
PORING_PACED=1
# 준실시간 대화 - 회차는 누가 언제 누구와 얘기할지만 정하고, 대화는 그 시각에 그때의 시각/상태로 만든다 (0이면 예전처럼 회차에서 미리)
PORING_LIVE=1
# 연재 장면을 카톡에도 대사 하나씩 보낸다 (0이면 장면 전체를 한 메시지로)
PORING_KAKAO_PER_LINE=1
# 연재 장면을 에이전트 대화 채널에 인물 이름/아바타로 한 줄씩 (그러면 방송 채널엔 안 감, 카톡은 그대로 / 0이면 예전처럼 방송 채널에)
PORING_SCENE_AGENT_CHANNEL=1
# 매시 "지금 동네는"을 동네 지도 그림(PNG) 한 장으로 (0이면 예전 글 버전) / 그림과 함께 글 버전도 올릴지
PORING_TOWN_MAP=1
PORING_TOWN_VIEW_TEXT=0
# 기본 모델이 분당 한도(429)에 걸리면 이만큼(초) 쉬고 한 번 더 (0이면 안 함)
PORING_LLM_RETRY_SEC=20
# 기억 의미 검색 - 로컬 임베딩(라그M 검색과 같은 모델, API 한도 안 씀). 0이면 키워드 검색만
PORING_MEMORY_SEMANTIC=1
PORING_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
# 임베딩에 쓰는 CPU 스레드 수 (저사양/발열 서버면 1)
PORING_EMBEDDING_THREADS=1
# 애순이 겸직(북오아시스) - 이야기에 쓸 서재 종류
BOOKOASIS_STORY_DB_TYPES=general,audiobook
# 담당 업무(김동식 '스페셜 라인')용으로 오늘 입고 권 수만 세는 서재 - 제목은 안 읽고, 이야기에는 '스페셜 라인'으로만 나온다
BOOKOASIS_ADULT_DB_TYPES=adult
# 연재 드라마 (poring_food/story.py)
PORING_STORY_ENABLED=1
# 대화 장면을 올릴 시각
PORING_SCENE_HOURS=9,11,13,15,17,20
# 하루 한 번 줄거리 갱신(작가 회의) 시각
PORING_WRITERS_ROOM_HOUR=23
# 장면 중 줄거리를 잇는 비율 (나머지는 우연한 일상 장면)
PORING_ARC_EPISODE_PROBABILITY=0.8
# 이야기의 실측 신호 (poring_food/mcp_signals.py) - config/mcp_servers.yaml의 서버 이름
PORING_WEATHER_MCP_SERVER=korea_weather
# 광주광역시청
PORING_WEATHER_LAT=35.1595
PORING_WEATHER_LON=126.8526
PORING_FACILITY_MCP_SERVER=server_status
# 이야기 속 설비 온도: 서버 센서 값을 화씨로 보고 섭씨로 바꿔 보여 줌 (95 -> 35°C, 실제 값으로 보려면 0)
PORING_FACILITY_TEMP_AS_F=1
PORING_MCP_SIGNAL_TIMEOUT_SEC=60
# 생산/판매/주문 지표 (poring_food/metrics.py)
PORING_PLEX_MCP_SERVER=plex
PORING_TAUTULLI_MCP_SERVER=tautulli
# Plex 상영 알림 (poring_food/plex_watch.py) - 재생이 시작되면 동네 단톡방에 알림 (TAUTULLI_API_KEY 필요)
PORING_PLEX_WATCH=1
TAUTULLI_URL=http://192.168.0.31:8181
PORING_PLEX_WATCH_ANNOUNCER=소라
PORING_PLEX_WATCH_PLACE=카페 오후세시 스크린
# 제목을 숨길 Plex 라이브러리 이름 (쉼표로) - 성인 등급 영상은 기본으로 숨김
PORING_PLEX_WATCH_HIDE_LIBRARIES=
PORING_PLEX_WATCH_MAX_PER_HOUR=3
# LLM 요청 수/토큰 (scripts/llm_usage_mcp.py) - 에린 '연산 처리'/'운영 경비' 실적
PORING_LLM_USAGE_MCP_SERVER=llm_usage
PORING_PRODUCTION_DEFAULT_TARGET=5
# 담당 실적 (poring_food/kpi.py) - 주간 실적 1등 보너스 / 월간 우수 사원 상여 (원, 이야기 속 돈)
PORING_KPI_WEEKLY_BONUS=300000
PORING_KPI_MONTHLY_BONUS=500000
# 고객 문의 창구(최수연 자리) - 평일 하루 가상 손님 문의 수 / 실제 사람 메시지(VIP) 1건 = 일반 문의 몇 건 실적
PORING_DESK_DAILY=60
PORING_DESK_VIP_WEIGHT=3
# LLM 에이전트(애순이/소라) - poring_food/agents.py, world.py
# 에이전트끼리 대화하는 채널 (비우면 PORING_DISCORD_CHANNEL_ID)
PORING_AGENT_CHANNEL_ID=
# 대화 한 번의 최대 발언 수
PORING_AGENT_MAX_TURNS=6
# 하루 최대 대화 수 / 한 시간에 벌어지는 대화 수 (한 사람은 한 시간에 한 대화)
PORING_AGENT_MAX_CONVOS_PER_DAY=48
PORING_AGENT_CONVOS_PER_HOUR=3
# 에이전트 최대 인원 (data/agents.json 앞에서부터)
PORING_AGENT_MAX=50
# 하루 한 번(5시 이후 첫 회차) 소속별로 에이전트 <-> 배경 인물 교체 (0이면 끔), 소속별 교체 인원
PORING_AGENT_ROTATION=1
PORING_AGENT_ROTATION_SWAPS=1
# 주 1회(월요일 아침) 드라마 인물 3~5명이 동네로 이사 온다 (0이면 끔), 동네 배경 인물 상한(넘으면 먼저 온 새 이웃이 이사 감)
PORING_NEWCOMERS=1
PORING_MAX_TOWN_NPC=60
# 회사 단톡방 - 포링푸드 소속 에이전트가 같이 보고 쓰는 채널 (기본: 기존 포링푸드 이야기 채널)
PORING_GROUP_CHAT_CHANNEL_ID=1524285939365707868
# 비우면 카제/아메하나가 그 채널 웹훅을 찾거나 만든다
PORING_GROUP_WEBHOOK_URL=
PORING_GROUP_MAX_POSTS_PER_DAY=10
# 동네 단톡방 하루 상한 (멤버가 22명이라 회사 단톡방보다 넉넉히), 단톡방 시간당 상한
PORING_TOWN_GROUP_MAX_POSTS_PER_DAY=24
PORING_GROUP_MAX_POSTS_PER_HOUR=3
# 동네 단톡방 채널 - 0이면 PORING_AGENT_CHANNEL_ID(에이전트 대화 채널)에 '🏘️ 동네 단톡방' 머리말을 붙여 올린다
PORING_TOWN_CHAT_CHANNEL_ID=0
# 매시 '지금 다들 뭐 하나' 근황 요약을 에이전트 대화 채널에 올린다 (0이면 끔)
PORING_AGENT_STATUS_DIGEST=1
# 발언 사이 간격(초) - 사람처럼 보이게
PORING_AGENT_DELAY_MIN=3
PORING_AGENT_DELAY_MAX=8
