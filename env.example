# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=   # 봇이 실제로 들어가 있는 서버 ID (개발자 모드 켜고 서버 아이콘 우클릭 -> ID 복사)
DISCORD_LOG_CHANNEL_IDS=   # comma-separated channel IDs, 대괄호/따옴표 없이. 예: 591180628842774554,591180628842774555

# Kakao (디스코드 채널 릴레이 방식 - 원본 봇과 동일)
KATALK_BRIDGE_URL=http://192.168.0.50:3000   # 답장을 내보낼 때만 사용
KATALK_LINKED_CHANNEL_IDS=   # 카톡이 릴레이되는 디스코드 채널 ID들 (comma-separated, 기존 TARGET_THREAD_IDS)
NICKNAME_DELIMITER=//

# 자율 응답(호출어 없이 확률적으로 참견) - 카톡/디스코드 공용, 기존 봇과 동일 기본값
AUTO_REPLY_TRIGGER_KEYWORDS=애순,똑똑,안녕
AUTO_REPLY_COOLDOWN_SEC=60
AUTO_REPLY_PROBABILITY=0.03

# 대화 맥락 - 애순이가 답할 때 참고하는 최근 메시지 개수 (SQLite에서 조회)
CONVERSATION_CONTEXT_LIMIT=12

# LLM (LiteLLM proxy)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Image generation backend (AI Horde)
IMAGE_GEN_BACKEND=horde
IMAGE_GEN_MAX_CONCURRENCY=2
HORDE_API_KEY=
HORDE_DEFAULT_MODEL=Nova Anime XL

# Poring Food file-contract paths (kept compatible with existing poring_food cron)
PORING_FOOD_STATUS_JSON_PATH=./storage/aesun_current_status.json
