# Discord
DISCORD_BOT_TOKEN=
# 애순이 디스코드 계정(말하기 전용). 카톡 연동 채널의 애순이 답장과 포링푸드 일지/장면을 이 계정으로 올린다.
# 비우면 전부 아메하나 계정으로. 초대 권한: View Channel / Send Messages / Send Messages in Threads / Read Message History
AESUN_BOT_TOKEN=
# 소라 디스코드 계정 - 맡은 일 없이 로그인만 (상태 메시지는 선택). 비우면 로그인 안 함.
SORA_BOT_TOKEN=
SORA_BOT_ACTIVITY=
# 보조 계정 키 목록 (포링푸드 에이전트를 최대 5명까지 늘릴 때 키 추가 + {KEY}_BOT_TOKEN, poring_food/data/agents.json에 인물 추가)
SIDE_BOT_KEYS=aesun,sora
DISCORD_GUILD_ID=   # 봇이 실제로 들어가 있는 서버 ID (개발자 모드 켜고 서버 아이콘 우클릭 -> ID 복사)
DISCORD_LOG_CHANNEL_IDS=   # comma-separated channel IDs, 대괄호/따옴표 없이. 예: 591180628842774554,591180628842774555

# Kakao (디스코드 채널 릴레이 방식 - 원본 봇과 동일)
# 카톡 애순이가 해요체로 대할 사람 (말투 전용, 권한과 무관). 나머지는 합쇼체. 유저ID(member_no) 권장.
KAKAO_FAMILIAR_USER_IDS=
KAKAO_FAMILIAR_NAMES=유메미루
KATALK_BRIDGE_URL=http://192.168.0.50:3000   # 답장을 내보낼 때만 사용
KATALK_LINKED_CHANNEL_IDS=   # 카톡이 릴레이되는 디스코드 채널 ID들 (comma-separated, 기존 TARGET_THREAD_IDS)
NICKNAME_DELIMITER=//

# 자율 응답(호출어 없이 확률적으로 참견) - 카톡/디스코드 공용, 기존 봇과 동일 기본값
AUTO_REPLY_TRIGGER_KEYWORDS=애순,똑똑,안녕
AUTO_REPLY_COOLDOWN_SEC=60
AUTO_REPLY_PROBABILITY=0.03
# 호출어로 부른 뒤 이 시간(초) 동안은 같은 사람이 호출어 없이 말해도 답한다 (0이면 끔)
CALL_FOLLOWUP_SEC=300

# 대화 맥락 - 애순이가 답할 때 참고하는 최근 메시지 개수 (SQLite에서 조회)
CONVERSATION_CONTEXT_LIMIT=12

# LLM (LiteLLM proxy)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Image generation backend (AI Horde)
IMAGE_GEN_BACKEND=horde
IMAGE_GEN_MAX_CONCURRENCY=2
HORDE_API_KEY=
HORDE_DEFAULT_MODEL=Nova Anime XL


# 부팅 때 MCP 서버별 연결 대기 시간(초). SSH로 붙는 bookoasis가 자주 타임아웃되면 늘린다.
MCP_CONNECT_TIMEOUT_SEC=30
# MCP 서버 시크릿 - config/mcp_servers.yaml이 "${변수명}"으로 참조한다 (yaml엔 값을 적지 않음)
TAUTULLI_API_KEY=
PLEX_TOKEN=
PUBLIC_DATA_API_SECRET=

# 봇이 반응하지 않을 자동화 발신자 이름 (쉼표로 여러 개). ".GAS"로 끝나는 이름과
# 카톡 릴레이가 아닌 웹훅은 등록하지 않아도 자동으로 무시된다.
GAS_WEBHOOK_NAMES=4KHD_SNDER.GAS

# scripts/new_content_notifier.py (크론) - 새 콘텐츠 알림을 보낼 채널
NEW_CONTENT_NOTIFY_CHANNEL_ID=

# Redroid 패키지 감시 결과를 봇이 알릴 채널 (비우면 끔) - cogs/redroid_watch.py
REDROID_NOTIFY_CHANNEL_ID=591180628842774554
REDROID_EVENTS_PATH=/mnt/redroid_watch/events.jsonl

# 포링푸드 (poring_food/ - 매시 애순이 일지, cogs/poring_food.py)
PORING_FOOD_ENABLED=1
PORING_FOOD_RUN_MINUTE=3
PORING_DISCORD_CHANNEL_ID=        # 봇이 직접 올릴 채널 (비우면 아래 웹훅 사용)
PORING_DISCORD_WEBHOOK_URL=       # 예전 포링푸드 .env의 DISCORD_WEBHOOK_URL
PORING_KAKAO_ROOM_ID=             # 예전 포링푸드 .env의 ROOM_ID
PORING_LLM_MODEL=                 # 비우면 LITELLM_MODEL (예전 .env의 LLM_MODEL)
PORING_SEARCH_MODEL=gemini-search # 예전 .env의 SEARCH_MODEL
# 애순이 겸직(북오아시스) - 이야기에 쓸 서재 종류
BOOKOASIS_STORY_DB_TYPES=general,audiobook
# 연재 드라마 (poring_food/story.py)
PORING_STORY_ENABLED=1
PORING_SCENE_HOURS=9,11,13,15,17,20   # 대화 장면을 올릴 시각
PORING_WRITERS_ROOM_HOUR=23           # 하루 한 번 줄거리 갱신(작가 회의) 시각
PORING_ARC_EPISODE_PROBABILITY=0.8    # 장면 중 줄거리를 잇는 비율 (나머지는 우연한 일상 장면)
# 이야기의 실측 신호 (poring_food/mcp_signals.py) - config/mcp_servers.yaml의 서버 이름
PORING_WEATHER_MCP_SERVER=korea_weather
PORING_WEATHER_LAT=35.1595            # 광주광역시청
PORING_WEATHER_LON=126.8526
PORING_FACILITY_MCP_SERVER=server_status
PORING_MCP_SIGNAL_TIMEOUT_SEC=60
# 생산/판매/주문 지표 (poring_food/metrics.py)
PORING_PLEX_MCP_SERVER=plex
PORING_TAUTULLI_MCP_SERVER=tautulli
PORING_PRODUCTION_DEFAULT_TARGET=5
# LLM 에이전트(애순이/소라) - poring_food/agents.py, world.py
PORING_AGENT_CHANNEL_ID=               # 에이전트끼리 대화하는 채널 (비우면 PORING_DISCORD_CHANNEL_ID)
PORING_AGENT_MAX_TURNS=6               # 대화 한 번의 최대 발언 수
PORING_AGENT_MAX_CONVOS_PER_DAY=8      # 하루 최대 대화 수 (시간당 1번)
PORING_AGENT_DELAY_MIN=3               # 발언 사이 간격(초) - 사람처럼 보이게
PORING_AGENT_DELAY_MAX=8    # 최근 7일 기록이 없을 때의 하루 생산(신규 입고) 기준
