# 설치: sudo cp deploy/discord-bot-v2.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now discord-bot-v2.service
#
# User/WorkingDirectory/ExecStart 경로는 실제 서버 배포 경로에 맞게 수정할 것.
# (scripts/git_pull_deploy.sh가 이 서비스명(discord-bot-v2.service)을 재시작 대상으로 사용함)

[Unit]
Description=Aesun Discord Bot v2 (discord_bot_v2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/mnt/discord_bot_v2
ExecStart=/mnt/discord_bot_v2/venv/bin/python /mnt/discord_bot_v2/app.py
Restart=on-failure
RestartSec=5

# .env(config/settings.py가 python-dotenv로 자동 로드)는 코드가 직접 읽으므로
# systemd EnvironmentFile은 필요 없음. 필요하면 아래 줄의 주석을 해제해서 겸용 가능.
# EnvironmentFile=/mnt/discord_bot_v2/.env

StandardOutput=append:/var/log/discord-bot-v2/stdout.log
StandardError=append:/var/log/discord-bot-v2/stderr.log

# 로그 디렉터리가 없으면 서비스가 뜨지 않으므로 사전에 생성 필요:
#   sudo mkdir -p /var/log/discord-bot-v2 && sudo chown discordbot:discordbot /var/log/discord-bot-v2

[Install]
WantedBy=multi-user.target
