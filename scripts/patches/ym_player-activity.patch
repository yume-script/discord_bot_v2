@@ -80,6 +81,44 @@ class _RecentWarnings(logging.Handler):
 RECENT = _RecentWarnings()
 STARTED = time.time()
 
+
+class _Activity:
+    """지금 재생 중인 스트림 수 (메모리에만) - 서버 부하 조절(discord_bot_v2 결계 조절)이 "누가 보고 있나"를 묻는다.
+    제목/사용자 이름은 남기지 않고 종류별 숫자만. 중계로 흐르는 요청만 보인다 (원본 주소로 바로 트는 IPTV는 안 보임).
+    - 끝나지 않은 스트림 요청(mpegts 같은 긴 연결)은 진행 중으로 센다.
+    - 조각 요청(HLS/조각 받기)은 마지막 요청 뒤 HOLD초 동안 재생 중으로 본다."""
+    HOLD = 45
+
+    def __init__(self):
+        self.open = collections.Counter()      # 종류 -> 지금 열려 있는 요청 수
+        self.last = {}                         # (종류, 키) -> 마지막 요청 시각
+
+    @staticmethod
+    def kind(request):
+        """요청 -> (종류, 키) 또는 None. 키는 같은 재생을 하나로 세는 용도 (주소/메시지 단위)."""
+        path = request.path
+        if path == "/api/stream":
+            return "live", hash(request.query.get("url", ""))
+        if path.startswith(("/api/tg/", "/api/tg-hls/")) and ("/stream/" in path or "/transcode/" in path
+                                                             or path.startswith("/api/tg-hls/")):
+            parts = path.split("/")
+            return "telegram", hash("/".join(parts[3:7]) if path.startswith("/api/tg/") else parts[3])
+        if path.startswith("/api/plex/") and ("/library/parts/" in path or "/transcode/" in path):
+            return "plex", hash(path.split("/library/parts/")[-1].split("/")[0] if "/library/parts/" in path
+                                else request.query.get("session", "") or path)
+        return None
+
+    def now(self):
+        cutoff = time.time() - self.HOLD
+        self.last = {k: t for k, t in self.last.items() if t >= cutoff}
+        by = collections.Counter(kind for kind, _ in self.last)
+        for kind, n in self.open.items():
+            by[kind] = max(by[kind], n)
+        return {k: v for k, v in by.items() if v}
+
+
+ACTIVITY = _Activity()
+
 HTTP = web.AppKey("http", ClientSession)
 CHANNEL_CACHE = web.AppKey("channel_cache", dict)
 EPG_CACHE = web.AppKey("epg_cache", dict)
@@ -116,11 +155,36 @@ async def auth_middleware(request, handler):
         return await handler(request)
     if request.path in _PUBLIC_PATHS or request.path.startswith(("/static/", "/s/", "/internal/tg/")):
         return await handler(request)
+    token = os.getenv("MP_ACTIVITY_TOKEN", "")
+    if request.path == "/api/activity" and token and hmac.compare_digest(request.headers.get("X-Activity-Token", ""), token):
+        return await handler(request)
     if request.path.startswith("/api/"):
         return web.json_response({"success": False, "error": "로그인이 필요합니다.", "login": True}, status=401)
     raise web.HTTPFound("/login")
 
 
+@web.middleware
+async def activity_middleware(request, handler):
+    """재생 스트림 요청을 센다 (ACTIVITY). 로그인 검사가 끝난 뒤라 로그인한 사람의 재생만 잡힌다."""
+    k = ACTIVITY.kind(request)
+    if not k:
+        return await handler(request)
+    ACTIVITY.last[k] = time.time()
+    ACTIVITY.open[k[0]] += 1
+    try:
+        return await handler(request)
+    finally:
+        ACTIVITY.open[k[0]] -= 1
+        ACTIVITY.last[k] = time.time()
+
+
+async def activity_get(request):
+    """GET /api/activity -> {"playing": 수, "by": {"plex"|"telegram"|"live": 수}} - 숫자만 (제목/사용자 없음).
+    로그인 없이 쓰려면 MP_ACTIVITY_TOKEN을 정하고 X-Activity-Token 헤더로 보낸다 (서버 부하 조절 봇용)."""
+    by = ACTIVITY.now()
+    return web.json_response({"success": True, "playing": sum(by.values()), "by": by, "hold_sec": ACTIVITY.HOLD})
+
+
 def is_admin(request):
