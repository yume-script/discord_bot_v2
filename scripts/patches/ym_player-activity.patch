@@ -463,3 +463,43 @@ def test_radio_source_and_now_playing(monkeypatch, tmp_path):
         return "ART" if (artist, title) == ("Bill Evans", "Peace Piece") else ""
 
     asyncio.run(run())
+
+
+def test_activity_counts_playing_streams_without_titles(monkeypatch, tmp_path):
+    """재생 스트림(중계/텔레그램/Plex 원본) 요청은 '재생 중'으로 세고, 목록/이미지 같은 건 안 센다."""
+    pytest.importorskip("aiohttp")
+    import time
+
+    from aiohttp.test_utils import TestClient, TestServer, make_mocked_request
+
+    from ym_player import server
+
+    act = server._Activity()
+    assert act.kind(make_mocked_request("GET", "/api/stream?url=http://x/live.ts"))[0] == "live"
+    assert act.kind(make_mocked_request("GET", "/api/tg/t1/stream/-100/5"))[0] == "telegram"
+    assert act.kind(make_mocked_request("GET", "/api/tg-hls/job1/seg3.ts"))[0] == "telegram"
+    assert act.kind(make_mocked_request("GET", "/api/plex/px/library/parts/12/file.mkv"))[0] == "plex"
+    for path in ("/api/tg/t1/thumb/-100/5", "/api/plex/px/library/sections", "/api/iptv/tv/channels", "/"):
+        assert act.kind(make_mocked_request("GET", path)) is None
+    act.last[("live", 1)] = time.time() - 100                              # 오래된 조각 요청은 끝난 것
+    act.last[("plex", 2)] = time.time()
+    act.open["telegram"] = 1                                               # 아직 열려 있는 긴 스트림
+    assert act.now() == {"plex": 1, "telegram": 1}
+
+    monkeypatch.setattr(config_store, "CONFIG_FILE", str(tmp_path / "config.json"))
+    monkeypatch.setattr(config_store, "DATA_DIR", str(tmp_path))
+    monkeypatch.setenv("MP_ACTIVITY_TOKEN", "sekret")
+
+    async def run():
+        client = TestClient(TestServer(server.create_app(require_auth=True)))
+        await client.start_server()
+        try:
+            assert (await client.get("/api/activity")).status == 401                       # 토큰 없으면 로그인 필요
+            assert (await client.get("/api/activity", headers={"X-Activity-Token": "nope"})).status == 401
+            r = await client.get("/api/activity", headers={"X-Activity-Token": "sekret"})
+            body = await r.json()
+            assert r.status == 200 and set(body) == {"success", "playing", "by", "hold_sec"}
+            assert (await client.get("/api/config", headers={"X-Activity-Token": "sekret"})).status == 401  # 다른 건 안 열림
+        finally:
+            await client.close()
+    asyncio.run(run())
